#vim: set filetype=zsh

is_remote(){
  test -n "${SSH_CONNECTION}${SSH_CLIENT}"
}

is_root(){
  test $UID -eq 0
}

prompt_user(){
  local p_user='%F{blue}%n%f'
  is_root && p_user='%F{yellow}%B%n%b%f'

  echo "$p_user"
}

prompt_user_and_host(){
  if is_remote || is_root ; then
    local p_host='%F{green}%m%f'
    echo "$( prompt_user )@${p_host}:"
  else
    echo ''
  fi
}

prompt_tool_versions(){
  setopt localoptions noshwordsplit
  local tools=()

  if type rbenv &>/dev/null; then
    local ruby_ver=$(rbenv version-name 2>/dev/null)
    if [[ -n "$ruby_ver" && "$ruby_ver" != "system" ]]; then
      tools+="%F{196} $ruby_ver%f"
    fi
  fi

  if type tfenv &>/dev/null; then
    local tf_ver=$(tfenv version-name 2>/dev/null)
    if [[ -n "$tf_ver" ]]; then
      tools+="%F{39}󱁢 $tf_ver%f"
    fi
  fi

  echo "$tools"
}
